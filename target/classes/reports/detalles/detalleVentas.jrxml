	<dataset name="detalleVentas" uuid="98513516-8ad3-4ac3-b98a-b33749d38359">
		<property name="com.jaspersoft.studio.data.sql.tables" value="c2FsZXNwb2ludGZ4LnN1Y3Vyc2FscHJvZHVjdG8gLDE5Miw2NywzODRhOTgzYS1hYmNmLTRkMmUt&#xa;YTZlMC02Mjk1YzBiZTExZWI7c2FsZXNwb2ludGZ4LmNvcnRlZGV0YWxsZSAsMTUsMTUsYzUzN2E0&#xa;ZDItOTIzOS00MDVhLWI1MDQtM2Q0ZGNmZmNmMTE0O3NhbGVzcG9pbnRmeC5wcm9kdWN0byAsMzgw&#xa;LDEyMCxjYmQ0OTU5ZC1hOTIyLTQ2YzMtYWY4Mi1hODliZGNjY2FlZmU7"/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MysqlAdapter"/>
		<parameter name="idCorteVentas" class="java.lang.Integer"/>
		<query language="SQL"><![CDATA[SELECT salespointfx.producto.`nombreProducto`,
	salespointfx.cortedetalle.canceladas,
	salespointfx.cortedetalle.peso,
	salespointfx.cortedetalle.venta,
	 salespointfx.sucursalproducto.precio 
FROM salespointfx.cortedetalle
	INNER JOIN salespointfx.sucursalproducto ON 
	 salespointfx.cortedetalle.`sucursalProducto` = salespointfx.sucursalproducto.`idSucursalProducto` 
	INNER JOIN salespointfx.producto ON 
	 salespointfx.sucursalproducto.producto = salespointfx.producto.`idProducto` 
WHERE 
	 salespointfx.cortedetalle.corte = $P{idCorteVentas} 
	 AND salespointfx.sucursalproducto.vendible = TRUE
	 AND(salespointfx.producto.`nombreProducto`<>0 OR
	salespointfx.cortedetalle.canceladas<>0 OR
	salespointfx.cortedetalle.peso<>0 OR
	salespointfx.cortedetalle.venta<>0 )]]></query>
		<field name="nombreProducto" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nombreProducto"/>
			<property name="com.jaspersoft.studio.field.label" value="nombreProducto"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="producto"/>
		</field>
		<field name="canceladas" class="java.lang.Float">
			<property name="com.jaspersoft.studio.field.name" value="canceladas"/>
			<property name="com.jaspersoft.studio.field.label" value="canceladas"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="cortedetalle"/>
		</field>
		<field name="peso" class="java.lang.Float">
			<property name="com.jaspersoft.studio.field.name" value="peso"/>
			<property name="com.jaspersoft.studio.field.label" value="peso"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="cortedetalle"/>
		</field>
		<field name="venta" class="java.lang.Float">
			<property name="com.jaspersoft.studio.field.name" value="venta"/>
			<property name="com.jaspersoft.studio.field.label" value="venta"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="cortedetalle"/>
		</field>
		<field name="precio" class="java.lang.Float">
			<property name="com.jaspersoft.studio.field.name" value="precio"/>
			<property name="com.jaspersoft.studio.field.label" value="precio"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="sucursalproducto"/>
		</field>
	</dataset>
	<parameter name="idCorte" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT `idCorte`
FROM salespointfx.corte
WHERE 
	 salespointfx.corte.`idCorte` =  $P{idCorte} ]]></query>
	<field name="idCorte" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="idCorte"/>
		<property name="com.jaspersoft.studio.field.label" value="idCorte"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="corte"/>
	</field>
